# Copy to .env and fill in. Never commit .env.

# OpenAI key used to summarize each relevant job.
OPENAI_API_KEY=

# Telegram bot token from @BotFather, and the chat that receives alerts.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheet sync (Apps Script web app URL and shared secret)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
